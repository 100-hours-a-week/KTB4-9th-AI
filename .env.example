# DB
DB_HOST=localhost
DB_PORT=5432
DB_USER=cosmos
DB_PASSWORD=cosmos_local_dev
DB_NAME=cosmos
DB_ECHO=true # 실행되는 SQL이 로그에 찍힘 
DATABASE_URL=postgresql+psycopg2://{username}:{password}@{host}:{port}/{db_name}

# Gemini
GEMINI_API_KEY=

# 노드별 모델 덮어쓰기 (기본값은 src/core/config.py의 LLMModels)
# LLM_MODELS__GENERATE_PROBLEM=gemini-3.8-flash
# LLM_MODELS__CHECK_CONTRADICTION=gemini-3.8-flash
# LLM_MODELS__GENERATE_REF_CODE=gemini-3.5-flash-lite
# LLM_MODELS__GENERATE_NL_KEYWORD=gemini-3.5-flash-lite
# LLM_MODELS__GENERATE_TESTCASE=gemini-3.5-flash-lite
# LLM_MODELS__GENERATE_SOLUTION_CODE=gemini-3.5-flash-lite
# LLM_MODELS__GENERATE_BATTLE_PROBLEM=gemini-3.5-flash-lite
# LLM_MODELS__EVALUATION_NL_SOLUTION=gemini-3.5-flash-lite

# 로컬 모델 서버 (vLLM, OpenAI 호환). 평가와 배치 생성에서 쓴다. URL에 /v1은 붙이지 않는다
VLLM_URL=
VLLM_API_KEY=

# 배치 생성 노드가 부를 vLLM 모델 이름. 비워 두면 배치도 Gemini를 쓴다
BATCH_LOCAL_MODEL=
# 아래는 기본값이면 생략한다. 특히 THINKING은 빈 값으로 두면 앱이 뜨지 않는다
# BATCH_LOCAL_FALLBACK=true
# BATCH_LOCAL_TIMEOUT_S=180
# BATCH_LOCAL_THINKING=false

# 관리자 API 인증 토큰. 비어 있으면 관리자 API가 전부 거절된다
# 로컬은 아무 값이나 넣고, 배포 환경은 SSM에서 주입한다 (openssl rand -base64 32)
ADMIN_TOKEN=

# langsmith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="cosmos"

# url
BACKEND_URL=http://localhost:8080 # 배포된 Spring은 /api까지 붙인다 (예: http://dev-be.cosmoscode.site/api)
JUDGE0_URL=http://localhost:2358

# batch
BATCH_ENABLED=false # true인 서버만 배치 스케줄러를 띄움
BATCH_TIMEZONE=Asia/Seoul
BATCH_CONCURRENCY=5 # 동시에 돌리는 생성 그래프 수. Gemini 쿼터에 맞춰 조절

# logging
LOG_LEVEL=INFO