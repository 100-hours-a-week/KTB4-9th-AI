# DB
DB_HOST=localhost
DB_PORT=5432
DB_USER=cosmos
DB_PASSWORD=cosmos_local_dev
DB_NAME=cosmos
DB_ECHO=true # 실행되는 SQL이 로그에 찍힘 
DATABASE_URL=postgresql+psycopg2://{username}:{password}@{host}:{port}/{db_name}

# Gemini
GEMINI_API_KEY=

# langsmith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="cosmos"

# url
BACKEND_URL=http://localhost:8080
JUDGE0_URL=http://localhost:2358

# batch
BATCH_ENABLED=false # true인 서버만 새벽 배치 스케줄러를 띄움
BATCH_TIMEZONE=Asia/Seoul
BATCH_CONCURRENCY=5 # 동시에 돌리는 생성 그래프 수. Gemini 쿼터에 맞춰 조절

# logging
LOG_LEVEL=INFO